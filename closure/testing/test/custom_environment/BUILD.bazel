load("@bazel_skylib//rules:build_test.bzl", "build_test")
load("//closure:defs.bzl", "closure_js_binary", "closure_js_library")

package(default_testonly = True)

licenses(["notice"])

closure_js_library(
    name = "externs",
    srcs = ["externs.js"],
    no_closure_library = True,
)

closure_js_library(
    name = "suite",
    srcs = ["custom_environment_test.js"],
    deps = [
        ":externs",
        "//closure/testing/library:stacktrace",
        "//closure/testing/library:testsuite",
    ],
)

closure_js_binary(
    name = "custom_environment",
    defs = [
        "--env=CUSTOM",
        "--jscomp_error=checkTypes",
    ],
    entry_points = ["goog:rules_closure.testing.CustomEnvironmentTest"],
    deps = [":suite"],
)

build_test(
    name = "custom_environment_test",
    targets = [":custom_environment"],
)
